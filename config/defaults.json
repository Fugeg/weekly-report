    "claudeProjectsPath": "C:\\Users\\Administrator\\.claude\\projects",
    "zcodeLogPath": "C:\\Users\\Administrator\\.zcode\\cli\\log",
    "traeConfigPath": "C:\\Users\\Administrator\\.trae"
  },
  "projectMarkers": [
    ".git",
    "package.json",
    "pyproject.toml",
    "setup.py",
    "requirements.txt",
    "Cargo.toml",
    "go.mod",
    "pom.xml",
    "build.gradle",
